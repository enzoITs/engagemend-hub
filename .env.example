# Chave secreta usada para derivar HMAC-SHA256 de telefones, nomes e menções.
#
# CRÍTICO — leia antes de gerar/trocar esta chave:
# - A chave é estável POR PROJETO. Trocá-la faz o mesmo membro virar uma
#   pessoa "diferente" em cada reprocessamento, destruindo qualquer análise
#   longitudinal de engajamento (o motor de pontuação depende disso).
# - Gere com algo como: python -c "import secrets; print(secrets.token_hex(32))"
# - NUNCA commite o arquivo `.env` real (apenas este `.env.example`).
# - Este projeto roda localmente: a chave vive em `.env` local, fora do
#   controle de versão (garanta que `.env` está no .gitignore) e fora do
#   diretório de saída do pipeline.
ANON_HMAC_KEY=changeme-generate-a-strong-random-key-and-never-commit-it

# Chave de CIFRAGEM (reversível) do cofre onde vivem mapping.json e o
# relatório de autores. É DIFERENTE de ANON_HMAC_KEY: essa aqui permite
# decifrar de volta (necessário para re-identificação controlada e para a
# reconciliação manual de autores); a de HMAC acima é deliberadamente
# irreversível. Nunca reaproveite uma chave para as duas finalidades.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAPPING_ENCRYPTION_KEY=changeme-generate-a-fernet-key-and-never-commit-it

# Diretório onde o mapping.json e o relatório de autores, ambos cifrados
# (re-identificação e reconciliação manual), são mantidos. Deve ficar FORA
# do diretório de saída do pipeline e com acesso restrito no sistema de
# arquivos.
MAPPING_STORE_DIR=./secure/mapping

# Limite de tamanho de arquivo aceito pela interface de upload (Fase 6), em MB.
MAX_UPLOAD_SIZE_MB=200
