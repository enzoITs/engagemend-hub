# Postgres (Neon). DATABASE_URL usa o pooler; DIRECT_URL é a conexão direta,
# usada só pelo Prisma Migrate (migration não funciona através do PgBouncer).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Bot do Discord. O token NÃO deve ter permissão de escrita (ver §10 do prompt).
DISCORD_TOKEN=
DISCORD_GUILD_ID=

# Sal do HMAC-SHA256 que pseudonimiza member_discord_id (§3).
# ATENÇÃO: trocar este valor invalida todo o histórico já coletado — os hashes mudam.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MEMBER_ID_SALT=

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
