.sim-acoes { display: flex; flex-direction: column; gap: 4px; }
.sim-acoes button {
  height: 32px; padding: 0 8px; border-radius: 6px; text-align: left;
  border: 1px solid rgb(255 255 255 / .14); color: #d9e8e0; font-size: 11px;
}
