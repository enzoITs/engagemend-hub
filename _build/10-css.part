}
.sim-testes { font-size: 11px; white-space: pre-wrap; color: #8fa79a; max-height: 128px; overflow-y: auto; }
.sim-testes b { color: var(--lime); }
.sim-testes i { color: #ffb4a8; font-style: normal; }
.sim-aberto-dica {
  position: absolute; right: 16px; bottom: 16px; z-index: 79;
