.sim-grupo h3 { font-size: 11px; font-weight: 600; color: #8fa79a; margin-bottom: 8px; letter-spacing: .06em; text-transform: uppercase; }
.sim-opcoes { display: flex; flex-wrap: wrap; gap: 4px; }
.sim-opcoes button {
